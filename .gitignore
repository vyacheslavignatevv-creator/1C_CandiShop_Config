# ==============================
# Служебные файлы платформы 1С
# ==============================
*.1CD          # Файлы информационных баз — они бинарные и огромные
*.dt           # Кэш-файлы платформы (Data Transfer)
*.log          # Логи работы платформы и конфигуратора
*.pfl          # Настройки запуска (пути к базам, ключи командной строки)
*.cdr          # Резервные копии файлов конфигурации (создаются при сохранении)

# Папки временных данных
1Cv8Tmp/       # Временные файлы сеанса пользователя
1Cv8Log/       # Технологический журнал (может разрастаться до гигабайт)

# ==============================
# Результаты экспорта/импорта
# ==============================
DumpFilesIndex.txt   # Индексный файл выгрузки конфигурации
ConfigDumpInfo.xml   # Метаданные о дампе конфигурации
Export/
Import/

# ==============================
# Бинарные объекты метаданных
# ==============================
*.cf            # Основной бинарный файл конфигурации (не коммитить!)
*.cfe           # Собранные расширения (*.cfe) — хранить через Git LFS!
*.v8i           # Ярлыки запуска (содержат пути к базе)

# ==============================
# Локальные настройки разработчика
# ==============================
*.user          # Персональные настройки интерфейса (цвета, шрифты)
*.wsx           # Рабочая область конфигуратора (layout окон)

# ==============================
# Операционная система и редакторы
# ==============================
.DS_Store       # MacOS
Thumbs.db       # Windows thumbnails cache
*~             # Резервные копии vim/nano
.vscode/        # Если используете VS Code как внешний редактор
.idea/          # Если используете IntelliJ IDEA